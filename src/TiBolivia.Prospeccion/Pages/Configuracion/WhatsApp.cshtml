@page
@model TiBolivia.Prospeccion.Pages.Configuracion.WhatsAppModel
@{
    ViewData["Title"] = "WhatsApp";
    string Marca(bool ok) => ok ? "✅" : "❌";
    string ColorEstado(string e) => e switch { "APPROVED" => "success", "PENDING" or "IN_APPEAL" => "warning text-dark", "" => "light text-dark", _ => "danger" };
}
<h3>Configuración de WhatsApp <span class="badge bg-primary fs-6 align-middle">Proveedor: @(Model.O.EsMeta ? "Meta (oficial)" : "TextMeBot")</span></h3>
@if (!Model.O.EsMeta)
{
    <div class="alert alert-warning small">
        <b>TextMeBot no es un servicio oficial de WhatsApp.</b> Usa un WhatsApp normal vinculado por QR: escribir a muchas personas que no lo tienen
        agendado puede hacer que WhatsApp <b>bloquee el número</b>. Úselo con pocos mensajes diarios y contactos que esperan su mensaje.
        Los mensajes salen con una pausa de @Model.O.TextMeBot.SegundosEntreMensajes s entre cada uno.
    </div>
}

<form method="post" asp-page-handler="Guardar" class="card p-3 mb-3" autocomplete="off">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="mb-0"><i class="bi bi-plug"></i> Datos de conexión</h5>
        <div class="btn-group" role="group">
            <input type="radio" class="btn-check" asp-for="Conexion.Proveedor" value="Meta" id="provMeta" />
            <label class="btn btn-outline-primary btn-sm" for="provMeta">Meta (oficial)</label>
            <input type="radio" class="btn-check" asp-for="Conexion.Proveedor" value="TextMeBot" id="provTmb" />
            <label class="btn btn-outline-primary btn-sm" for="provTmb">TextMeBot</label>
        </div>
    </div>
    <p class="small text-muted">Se guardan en la base de datos (las claves, cifradas) y se aplican al instante. Las claves no se muestran:
        déjelas vacías para conservar las actuales.</p>
    <div class="row g-2 solo-meta">
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">Phone Number ID</label><input asp-for="Conexion.PhoneNumberId" class="form-control" /></div>
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">WhatsApp Business Account ID</label><input asp-for="Conexion.BusinessAccountId" class="form-control" /></div>
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">App ID</label><input asp-for="Conexion.AppId" class="form-control" /></div>
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">Access Token permanente @(Model.TieneToken ? "✅" : "")</label>
            <input asp-for="Conexion.AccessToken" type="password" class="form-control" placeholder="@(Model.TieneToken ? "Configurado (vacío = no cambiar)" : "EAAG...")" autocomplete="new-password" /></div>
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">App Secret @(Model.TieneAppSecret ? "✅" : "")</label>
            <input asp-for="Conexion.AppSecret" type="password" class="form-control" placeholder="@(Model.TieneAppSecret ? "Configurado (vacío = no cambiar)" : "")" autocomplete="new-password" /></div>
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">Verify Token del webhook</label><input asp-for="Conexion.VerifyToken" class="form-control" /></div>
    </div>
    <div class="row g-2 solo-tmb">
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">API Key de TextMeBot @(Model.TieneTextMeBot ? "✅" : "")</label>
            <input asp-for="Conexion.TextMeBotApiKey" type="password" class="form-control" placeholder="@(Model.TieneTextMeBot ? "Configurada (vacío = no cambiar)" : "")" autocomplete="new-password" /></div>
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">Token del webhook</label><input asp-for="Conexion.TextMeBotTokenWebhook" class="form-control" /></div>
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">Segundos entre mensajes</label><input asp-for="Conexion.SegundosEntreMensajes" type="number" min="3" max="120" class="form-control" /></div>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">URL del chatbot (opcional)</label><input asp-for="Conexion.ChatbotUrl" class="form-control" placeholder="https://..." /></div>
        <div class="col-12 col-md-6 col-lg-4"><label class="form-label small mb-0">API Key del chatbot @(Model.TieneChatbotKey ? "✅" : "")</label>
            <input asp-for="Conexion.ChatbotApiKey" type="password" class="form-control" autocomplete="new-password" /></div>
        <div class="col-12 col-lg-4 d-flex align-items-end"><div class="form-check"><input asp-for="Conexion.RequerirConsentimiento" class="form-check-input" />
            <label asp-for="Conexion.RequerirConsentimiento" class="form-check-label small">Escribir solo a quien aceptó WhatsApp (recomendado)</label></div></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-save"></i> Guardar y aplicar</button></div>
</form>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card p-3 h-100">
            <h5>1. Datos configurados
                <span class="badge bg-@(Model.O.Simulacion ? "warning text-dark" : "success")">@(Model.O.Simulacion ? "Simulación" : "Activo")</span></h5>
            <div class="table-responsive"><table class="table table-sm small mb-2">
                @if (Model.O.EsMeta)
                {
                    <tr><td>@Marca(!string.IsNullOrEmpty(Model.O.PhoneNumberId))</td><td>Phone Number ID</td><td class="text-muted">obligatorio para enviar</td></tr>
                    <tr><td>@Marca(!string.IsNullOrEmpty(Model.O.AccessToken))</td><td>Access Token (permanente)</td><td class="text-muted">obligatorio para enviar</td></tr>
                    <tr><td>@Marca(!string.IsNullOrEmpty(Model.O.BusinessAccountId))</td><td>WhatsApp Business Account ID</td><td class="text-muted">para revisar plantillas</td></tr>
                    <tr><td>@Marca(!string.IsNullOrEmpty(Model.O.VerifyToken))</td><td>Verify Token</td><td class="text-muted">para conectar el webhook</td></tr>
                    <tr><td>@Marca(!string.IsNullOrEmpty(Model.O.AppSecret))</td><td>App Secret</td><td class="text-muted">seguridad del webhook</td></tr>
                }
                else
                {
                    <tr><td>@Marca(!string.IsNullOrEmpty(Model.O.TextMeBot.ApiKey))</td><td>API Key de TextMeBot</td><td class="text-muted">obligatoria para enviar</td></tr>
                    <tr><td>@Marca(!string.IsNullOrEmpty(Model.O.TextMeBot.TokenWebhook))</td><td>Token del webhook</td><td class="text-muted">para recibir respuestas</td></tr>
                }
                <tr><td>@Marca(Model.ChatbotConfigurado)</td><td>URL del chatbot</td><td class="text-muted">respuestas automáticas</td></tr>
                <tr><td>@Marca(Model.O.RequerirConsentimiento)</td><td>Exigir consentimiento (opt-in)</td><td class="text-muted">recomendado</td></tr>
            </table></div>
            <p class="small mb-1">Los datos se cambian en <b>Datos de conexión</b> (arriba) y se aplican al guardar, sin reiniciar.</p>
            <hr />
            <h6>URL del webhook para @(Model.O.EsMeta ? "Meta" : "el panel de TextMeBot")</h6>
            <code class="d-block mb-1">@Model.UrlWebhook</code>
            @if (Model.EsLocal)
            {
                <p class="small text-warning-emphasis mb-0">Está en su PC (localhost): Meta no puede llegar aquí. Abra un túnel con
                    <code>cloudflared tunnel --url http://localhost:5179</code> y use <code>https://...trycloudflare.com/webhooks/whatsapp</code>.</p>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card p-3 mb-3">
            <h5>2. Verificar conexión con Meta</h5>
            <form method="post" asp-page-handler="Verificar"><button class="btn btn-primary" @(Model.O.Simulacion || !Model.O.EsMeta ? "disabled" : "")>Verificar ahora</button></form>
            @if (Model.ErrorVerificacion is not null) { <div class="alert alert-danger small mt-2 mb-0">@Model.ErrorVerificacion</div> }
            @if (Model.Numero is { } n)
            {
                <dl class="row small mt-3 mb-0">
                    <dt class="col-5">Número</dt><dd class="col-7">@n.Numero</dd>
                    <dt class="col-5">Nombre verificado</dt><dd class="col-7">@n.NombreVerificado <span class="text-muted">(@n.EstadoNombre)</span></dd>
                    <dt class="col-5">Calidad</dt><dd class="col-7">@n.Calidad</dd>
                    <dt class="col-5">Límite diario</dt><dd class="col-7">@n.LimiteMensajes</dd>
                </dl>
                <div class="alert alert-success small mt-2 mb-0">Conexión correcta: el token y el Phone Number ID son válidos.</div>
            }
        </div>

        <div class="card p-3">
            <h5>3. Enviar mensaje de prueba</h5>
            <form method="post" asp-page-handler="Prueba" class="row g-2">
                <div class="col-md-5"><input asp-for="Telefono" class="form-control" placeholder="71234567" /></div>
                <div class="col-md-7">
                    <select asp-for="PlantillaId" class="form-select">
                        <option value="0">@(Model.O.EsMeta ? "hello_world (prueba de Meta)" : "Mensaje de prueba simple")</option>
                        @foreach (var p in Model.PlantillasSistema) { <option value="@p.Id">@p.WhatsAppPlantillaMeta — @p.Nombre</option> }
                    </select>
                </div>
                <div class="col-12"><button class="btn btn-success">Enviar prueba</button></div>
            </form>
            <p class="small text-muted mt-2 mb-0">@(Model.O.EsMeta ? "" : "Con TextMeBot se envía el texto de la plantilla del sistema. ")Con el número de prueba de Meta, el destino debe estar agregado en "Configuración de la API → Para".</p>
        </div>
    </div>
</div>

@if (Model.O.EsMeta)
{
<div class="card p-3 mt-3">
    <h5>4. Plantillas usadas por las campañas</h5>
    <p class="small text-muted">Cada una debe existir en WhatsApp Manager con el <b>mismo nombre e idioma</b> y estar <b>APPROVED</b>.
        Pulse "Verificar ahora" para ver su estado (requiere el Business Account ID). Textos sugeridos en <code>docs/CAMPANAS.md</code>.</p>
    <div class="table-responsive"><table class="table table-sm small mb-0">
        <thead><tr><th>Nombre en Meta</th><th>Idioma</th><th>Variables</th><th>Plantilla del sistema</th><th>Estado en Meta</th></tr></thead>
        <tbody>
        @foreach (var p in Model.PlantillasSistema)
        {
            var estado = Model.EstadoEnMeta(p);
            <tr>
                <td><code>@p.WhatsAppPlantillaMeta</code></td><td>@p.WhatsAppIdioma</td><td>@p.WhatsAppParametros</td>
                <td><a asp-page="/Plantillas/Editar" asp-route-id="@p.Id">@p.Nombre</a></td>
                <td>@if (estado != "") { <span class="badge bg-@ColorEstado(estado)">@estado</span> } else { <span class="text-muted">—</span> }</td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (Model.PlantillasMeta is { Count: > 0 } todas)
    {
        <details class="mt-2"><summary class="small">Todas las plantillas de su cuenta en Meta (@todas.Count)</summary>
            <div class="table-responsive"><table class="table table-sm small mt-2">
                @foreach (var t in todas) { <tr><td>@t.Nombre</td><td>@t.Idioma</td><td>@t.Categoria</td><td><span class="badge bg-@ColorEstado(t.Estado)">@t.Estado</span></td></tr> }
            </table></div>
        </details>
    }
</div>
}

@section Scripts {
<script>
    // Muestra solo los campos del proveedor elegido.
    function proveedor() {
        const meta = document.getElementById('provMeta').checked;
        document.querySelectorAll('.solo-meta').forEach(e => e.style.display = meta ? '' : 'none');
        document.querySelectorAll('.solo-tmb').forEach(e => e.style.display = meta ? 'none' : '');
    }
    document.querySelectorAll('input[name="Conexion.Proveedor"]').forEach(r => r.addEventListener('change', proveedor));
    proveedor();
</script>
}

@page
@model TiBolivia.Prospeccion.Pages.Cuenta.LoginModel
@{ ViewData["Title"] = "Ingresar"; }
<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card p-4">
            <h4 class="mb-3">Ingresar</h4>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger small"></div>
                <div class="mb-3"><label class="form-label">Correo</label><input asp-for="Email" class="form-control" autofocus /></div>
                <div class="mb-3"><label class="form-label">Contraseña</label><input asp-for="Password" class="form-control" /></div>
                <div class="form-check mb-3"><input asp-for="Recordarme" class="form-check-input" /><label class="form-check-label" asp-for="Recordarme">Recordarme</label></div>
                <button class="btn btn-primary w-100">Ingresar</button>
            </form>
        </div>
    </div>
</div>

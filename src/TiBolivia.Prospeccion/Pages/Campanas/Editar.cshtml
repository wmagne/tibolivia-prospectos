@page "{id:int?}"
@model TiBolivia.Prospeccion.Pages.Campanas.EditarModel
@{ ViewData["Title"] = Model.Id == 0 ? "Nueva campaña" : Model.Nombre; }
<h3>@ViewData["Title"]</h3>
<div class="row g-3">
    <div class="col-lg-5">
        <form method="post" class="card p-4">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3"><label class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger small"></span></div>
            <div class="mb-3"><label class="form-label">Servicio que promociona</label><select asp-for="ServicioId" asp-items="Model.Servicios" class="form-select"><option value="">(ninguno)</option></select>
                <div class="form-text">Se usa en las variables {{Servicio}} y {{DescripcionServicio}}.</div></div>
            <div class="mb-3"><label class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="2"></textarea></div>
            <div class="form-check mb-3"><input asp-for="PausarAlResponder" class="form-check-input" /><label asp-for="PausarAlResponder" class="form-check-label">Pausar la secuencia cuando el prospecto responda</label></div>
            <button class="btn btn-primary">Guardar</button>
        </form>
    </div>
    @if (Model.Id != 0)
    {
        <div class="col-lg-7">
            <div class="card p-4">
                <h5>Secuencia</h5>
                <table class="table table-sm">
                    <thead><tr><th>#</th><th>Espera</th><th>Canal</th><th>Plantilla</th><th></th></tr></thead>
                    <tbody>
                    @{ var acumulado = 0; }
                    @foreach (var paso in Model.Pasos)
                    {
                        acumulado += paso.DiasEspera;
                        <tr>
                            <td>@paso.Orden</td>
                            <td>+@paso.DiasEspera días <span class="text-muted small">(día @acumulado)</span></td>
                            <td>@Etiquetas.Texto(paso.Canal)</td>
                            <td><a asp-page="/Plantillas/Editar" asp-route-id="@paso.PlantillaId">@paso.Plantilla!.Nombre</a></td>
                            <td><form method="post" asp-page-handler="EliminarPaso" asp-route-id="@Model.Id"><input type="hidden" name="pasoId" value="@paso.Id" /><button class="btn btn-sm btn-link text-danger">Quitar</button></form></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <form method="post" asp-page-handler="AgregarPaso" asp-route-id="@Model.Id" class="row g-2">
                    <div class="col-md-3"><div class="input-group"><span class="input-group-text">+</span><input name="diasEspera" type="number" min="0" value="@(Model.Pasos.Count == 0 ? 0 : 3)" class="form-control" /><span class="input-group-text">días</span></div></div>
                    <div class="col-md-6">
                        <select name="plantillaId" class="form-select">
                            @foreach (var pl in Model.Plantillas) { <option value="@pl.Id">[@Etiquetas.Texto(pl.Canal)] @pl.Nombre</option> }
                        </select>
                    </div>
                    <div class="col-md-3"><button class="btn btn-outline-primary w-100">Agregar paso</button></div>
                </form>
            </div>
        </div>
    }
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

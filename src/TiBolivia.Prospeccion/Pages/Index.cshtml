@page
@model IndexModel
@{ ViewData["Title"] = "Panel"; }
<h3 class="mb-3">Panel comercial</h3>
<div class="row g-3 mb-4">
    <div class="col-md-2"><div class="card p-3"><div class="text-muted small">Prospectos</div><div class="kpi">@Model.TotalProspectos</div></div></div>
    <div class="col-md-2"><div class="card p-3"><div class="text-muted small">Enviados hoy</div><div class="kpi">@Model.EnviadosHoy</div></div></div>
    <div class="col-md-2"><div class="card p-3"><div class="text-muted small">Enviados (7 días)</div><div class="kpi">@Model.Enviados7Dias</div></div></div>
    <div class="col-md-2"><div class="card p-3"><div class="text-muted small">Respuestas (7 días)</div><div class="kpi text-success">@Model.Respuestas7Dias</div></div></div>
    <div class="col-md-2"><div class="card p-3"><div class="text-muted small">Fallidos (7 días)</div><div class="kpi text-danger">@Model.Fallidos7Dias</div></div></div>
    <div class="col-md-2"><div class="card p-3"><div class="text-muted small">En secuencia</div><div class="kpi">@Model.InscripcionesActivas</div></div></div>
</div>
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card p-3">
            <h5>Respondieron y esperan atención</h5>
            @if (Model.PorAtender.Count == 0) { <p class="text-muted mb-0">Nadie por atender. </p> }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>Empresa</th><th>Contacto</th><th>Asignado</th><th>Última respuesta</th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.PorAtender)
                    {
                        <tr>
                            <td><a asp-page="/Prospectos/Detalle" asp-route-id="@p.Id">@p.Empresa</a></td>
                            <td>@p.NombreContacto</td>
                            <td>@(p.AsignadoA?.NombreCompleto ?? "—")</td>
                            <td>@p.UltimaRespuestaEn?.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-3 mb-3">
            <h5>Embudo</h5>
            @foreach (var estado in Enum.GetValues<EstadoProspecto>())
            {
                var n = Model.PorEstado.GetValueOrDefault(estado);
                var pct = Model.TotalProspectos == 0 ? 0 : n * 100 / Model.TotalProspectos;
                <div class="d-flex align-items-center mb-1">
                    <a class="small" style="width:140px" asp-page="/Prospectos/Index" asp-route-estado="@estado">@Etiquetas.Texto(estado)</a>
                    <div class="progress flex-grow-1" style="height:16px"><div class="progress-bar bg-@Etiquetas.Color(estado)" style="width:@pct%"></div></div>
                    <span class="ms-2 small" style="width:40px">@n</span>
                </div>
            }
        </div>
        <div class="card p-3">
            <h5>Campañas</h5>
            <table class="table table-sm mb-0">
                <thead><tr><th>Campaña</th><th>Activas</th><th>Pausadas</th><th>Completadas</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Campanas)
                {
                    <tr><td>@c.Campana</td><td>@c.Activas</td><td>@c.Pausadas</td><td>@c.Completadas</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

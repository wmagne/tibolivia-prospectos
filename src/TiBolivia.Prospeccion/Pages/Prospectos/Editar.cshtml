@page "{id:int?}"
@model TiBolivia.Prospeccion.Pages.Prospectos.EditarModel
@{ ViewData["Title"] = Model.Datos.Id == 0 ? "Nuevo prospecto" : "Editar prospecto"; }
<h3>@ViewData["Title"]</h3>
<form method="post" class="card p-4">
    <input type="hidden" asp-for="Datos.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Datos.Empresa" class="form-label"></label><input asp-for="Datos.Empresa" class="form-control" /><span asp-validation-for="Datos.Empresa" class="text-danger small"></span></div>
        <div class="col-md-3"><label asp-for="Datos.Rubro" class="form-label"></label><input asp-for="Datos.Rubro" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Datos.Ciudad" class="form-label"></label><input asp-for="Datos.Ciudad" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Datos.NombreContacto" class="form-label"></label><input asp-for="Datos.NombreContacto" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="Datos.Cargo" class="form-label"></label><input asp-for="Datos.Cargo" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Datos.Email" class="form-label">Correo</label><input asp-for="Datos.Email" class="form-control" /><span asp-validation-for="Datos.Email" class="text-danger small"></span></div>
        <div class="col-md-3"><label asp-for="Datos.Telefono" class="form-label"></label><input asp-for="Datos.Telefono" class="form-control" placeholder="71234567 o +591..." /><span asp-validation-for="Datos.Telefono" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Datos.SitioWeb" class="form-label"></label><input asp-for="Datos.SitioWeb" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="Datos.Origen" class="form-label"></label><input asp-for="Datos.Origen" class="form-control" placeholder="Feria, referido..." /></div>
        <div class="col-md-3"><label asp-for="Datos.Estado" class="form-label"></label><select asp-for="Datos.Estado" asp-items="Etiquetas.Estados(Model.Datos.Estado)" class="form-select"></select></div>
        <div class="col-md-3"><label asp-for="Datos.AsignadoAId" class="form-label"></label><select asp-for="Datos.AsignadoAId" asp-items="Model.Usuarios" class="form-select"><option value="">(sin asignar)</option></select></div>
        <div class="col-md-2"><label asp-for="Datos.Prioridad" class="form-label"></label>
            <select asp-for="Datos.Prioridad" class="form-select"><option value="">—</option><option value="A">A · inmediata</option><option value="B">B · normal</option><option value="C">C · ciclo largo</option></select></div>
        <div class="col-md-5"><label asp-for="Datos.Necesidad" class="form-label"></label><input asp-for="Datos.Necesidad" class="form-control" placeholder="Correo corporativo, app de pedidos, CRM..." /></div>
        <div class="col-md-5"><label asp-for="Datos.Direccion" class="form-label"></label><input asp-for="Datos.Direccion" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Datos.Fuente" class="form-label"></label><input asp-for="Datos.Fuente" class="form-control" placeholder="sitio web o directorio" /></div>
        <div class="col-md-2"><label asp-for="Datos.ValorEstimado" class="form-label"></label><input asp-for="Datos.ValorEstimado" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Datos.ProximaAccion" class="form-label"></label><input asp-for="Datos.ProximaAccion" class="form-control" placeholder="Llamar a gerencia, enviar propuesta..." /></div>
        <div class="col-md-2"><label asp-for="Datos.FechaProximaAccion" class="form-label"></label><input asp-for="Datos.FechaProximaAccion" type="date" class="form-control" /></div>
        <div class="col-12"><label asp-for="Datos.Notas" class="form-label"></label><textarea asp-for="Datos.Notas" class="form-control" rows="3"></textarea></div>
        <div class="col-12 d-flex flex-wrap gap-3">
            <div class="form-check"><input asp-for="Datos.ConsentimientoWhatsApp" class="form-check-input" /><label asp-for="Datos.ConsentimientoWhatsApp" class="form-check-label"></label></div>
            <div class="form-check"><input asp-for="Datos.BajaEmail" class="form-check-input" /><label asp-for="Datos.BajaEmail" class="form-check-label"></label></div>
            <div class="form-check"><input asp-for="Datos.BajaWhatsApp" class="form-check-input" /><label asp-for="Datos.BajaWhatsApp" class="form-check-label"></label></div>
            <div class="form-check"><input asp-for="Datos.DatosPorVerificar" class="form-check-input" /><label asp-for="Datos.DatosPorVerificar" class="form-check-label"></label></div>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-primary">Guardar</button>
        <a asp-page="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
